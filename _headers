# Netlify cache rules. Images and fonts: 30 days. CSS/JS: 1 day, so edits show up quickly.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=2592000
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400
